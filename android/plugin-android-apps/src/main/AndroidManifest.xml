<?xml version="1.0" encoding="utf-8"?>
<!--
  The standalone plugin's manifest, less what belongs to an app of its own:
  its icon, label and launcher entry. Setup opens from Halone's settings.

  Everything runs in a process of its own, ":apps", as it did as a separate
  app. Not only for isolation: the plugin SDK checks every call's caller
  permission, and Android refuses that check for a call that never left the
  process, so in Halone's own process the shell could not even list the apps.
  Shizuku's provider is in the same process as the code that uses it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_ROAMING_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application>
        <activity
            android:name="dev.halone.plugin.android.SetupActivity"
            android:process=":apps"
            android:exported="true"
            android:label="@string/plugin_name"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="dev.halone.plugin.android.AndroidAppsProvider"
            android:process=":apps"
            android:exported="true"
            android:label="@string/plugin_name"
            android:permission="dev.halone.permission.BIND_PANEL_PROVIDER">
            <intent-filter>
                <action android:name="dev.halone.action.PANEL_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="dev.halone.plugin.CONTRACT"
                android:value="1" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:process=":apps"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
